      "firstName": "Dave",
      "lastName": "Operator",
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "realmRoles": ["OPERATOR"],
      "attributes": { "client_id": ["2"], "principal_kind": ["owner"], "tenant_code": ["GLOBEX"], "warehouse_id": ["WH-002"] }
    },
    {
      "username": "service-account-karyo-backend",
      "enabled": true,
      "serviceAccountClientId": "karyo-backend",
      "clientRoles": { "realm-management": ["view-events", "view-users"] }
    },
    {
      "username": "service-account-karyo-admin",
      "enabled": true,
      "serviceAccountClientId": "karyo-admin",
      "clientRoles": { "realm-management": ["manage-users", "view-realm"] }
    }
  ],
  "clients": [
    {
      "clientId": "karyo-backend",
      "enabled": true,
      "publicClient": false,
      "secret": "${OIDC_SECRET:dev-backend-secret}",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "client_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "client_id",
            "claim.name": "client_id",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "principal_kind",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "principal_kind",
            "claim.name": "principal_kind",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "tenant_code",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_code",
            "claim.name": "tenant_code",
