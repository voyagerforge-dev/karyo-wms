      "firstName": "Bob",
      "lastName": "Operator",
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "realmRoles": ["OPERATOR"],
      "attributes": { "client_id": ["1"], "principal_kind": ["ops"], "tenant_code": ["ACME"], "warehouse_id": ["WH-001"] }
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@acme.local",
      "firstName": "Carol",
      "lastName": "Viewer",
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "realmRoles": ["VIEWER"],
      "attributes": { "client_id": ["1"], "principal_kind": ["ops"], "tenant_code": ["ACME"] }
