{
  "realm": "karyo",
  "enabled": true,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subType": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\":\"ENABLED\",\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"client_id\",\"displayName\":\"Tenant Client ID\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"principal_kind\",\"displayName\":\"Principal Kind\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"tenant_code\",\"displayName\":\"Tenant Code\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"warehouse_id\",\"displayName\":\"Warehouse ID\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}]}"
          ]
        }
      }
    ]
  },
  "loginTheme": "karyo",
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 1800,
  "maxFailureWaitSeconds": 1800,
  "maxDeltaTimeSeconds": 43200,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "accessTokenLifespan": 900,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "inventory-read", "composite": false },
      { "name": "inventory-write", "composite": false },
      { "name": "product-read", "composite": false },
      { "name": "product-write", "composite": false },
      { "name": "layout-read", "composite": false },
      { "name": "layout-write", "composite": false },
      { "name": "order-read", "composite": false },
      { "name": "order-write", "composite": false },
      { "name": "task-read", "composite": false },
      { "name": "task-write", "composite": false },
      { "name": "fulfillment-read", "composite": false },
      { "name": "fulfillment-write", "composite": false },
      { "name": "report-read", "composite": false },
      { "name": "report-write", "composite": false },
      { "name": "user-admin", "composite": false },
      { "name": "tenant-admin", "composite": false },
      { "name": "integration-read", "composite": false },
      { "name": "integration-admin", "composite": false },
      { "name": "ai-read", "composite": false },
      { "name": "ai-write", "composite": false },
      {
        "name": "ADMIN",
        "composite": true,
        "composites": {
          "realm": [
            "inventory-read", "inventory-write",
            "product-read", "product-write",
            "layout-read", "layout-write",
            "order-read", "order-write",
            "task-read", "task-write",
            "fulfillment-read", "fulfillment-write",
            "report-read", "report-write",
            "user-admin", "tenant-admin",
            "integration-read", "integration-admin",
            "ai-read", "ai-write",
            "VIEWER"
          ]
        }
      },
      {
        "name": "MANAGER",
        "composite": true,
        "composites": {
          "realm": [
            "inventory-read", "inventory-write",
            "product-read", "product-write",
            "layout-read", "layout-write",
            "order-read", "order-write",
            "task-read", "task-write",
            "fulfillment-read", "fulfillment-write",
            "report-read", "report-write",
            "ai-read",
            "VIEWER"
          ]
        }
      },
      {
        "name": "OPERATOR",
        "composite": true,
        "composites": {
          "realm": [
            "inventory-read", "inventory-write",
            "product-read",
            "layout-read",
            "order-read", "order-write",
            "task-read", "task-write",
            "fulfillment-read", "fulfillment-write",
            "VIEWER"
          ]
        }
      },
      {
        "name": "RECEIVER",
        "composite": true,
        "composites": {
          "realm": [
            "inventory-read", "inventory-write",
            "product-read",
            "order-read", "order-write",
            "VIEWER"
          ]
        }
      },
      {
        "name": "VIEWER",
        "composite": true,
        "composites": {
          "realm": [
            "inventory-read",
            "product-read",
            "layout-read",
            "order-read",
            "task-read",
            "report-read"
          ]
        }
      },
      {
        "name": "INTEGRATOR",
        "composite": true,
        "composites": {
          "realm": [
            "inventory-read",
            "order-read", "order-write",
            "product-read", "product-write",
            "integration-read"
          ]
        }
      },
      {
        "name": "AI_SERVICE",
        "composite": true,
        "composites": {
          "realm": [
            "inventory-read",
            "product-read",
            "layout-read",
            "order-read",
            "report-read",
            "ai-read", "ai-write"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@karyo.local",
      "firstName": "System",
      "lastName": "Administrator",
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["ADMIN"],
      "attributes": { "client_id": ["0"], "principal_kind": ["ops"], "tenant_code": ["SYS"] }
