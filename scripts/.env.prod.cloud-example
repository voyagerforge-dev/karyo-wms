# Karyo WMS Cloud Environment -- Oracle Cloud Always Free (4 OCPU, 24GB RAM, ARM64)
# Usage: cp scripts/.env.prod.cloud-example scripts/.env.prod && edit credentials and public URLs
#
# Memory Budget (24GB total):
#   PostgreSQL:           2.0 GB
#   Keycloak:             2.0 GB
#   karyo-app (modulith): 4.0 GB
#   Nginx:                128 MB
#   OS + Docker overhead: ~2.0 GB
#   -----------------------------------
#   Total:                ~10.1 GB (13.9 GB headroom for builds and spikes)

# --- Shared PostgreSQL role ---
# Keep DB_*, POSTGRES_*, and KC_DB_* credentials aligned.
DB_USERNAME=karyo
DB_PASSWORD=CHANGE_ME_strong_password_here
DB_URL=jdbc:postgresql://postgresql:5432/karyo
POSTGRES_USER=karyo
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=karyo
KC_DB_USERNAME=karyo
KC_DB_PASSWORD=CHANGE_ME_strong_password_here

# --- Keycloak bootstrap admin (externally supplied; needed only for a fresh Keycloak
# database or a --reset-db deploy; delete the account and both lines below after
# first-user provisioning) ---
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_bootstrap_admin_username
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_generate_a_strong_admin_password

# --- OIDC (app -> Keycloak, internal network) ---
OIDC_URL=http://keycloak:8080/auth/realms/karyo
OIDC_SECRET=CHANGE_ME_generate_a_long_random_secret
KEYCLOAK_ADMIN_URL=http://keycloak:8080/auth

# --- Karyo user-administration service identity (separate from bootstrap and OIDC secrets) ---
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_generate_a_distinct_admin_client_secret

# --- Browser-canonical public origin (required; no default port, path, trailing slash, or wildcard) ---
KARYO_PUBLIC_ORIGIN=https://cloud.karyo.example.com
KARYO_DOMAIN=cloud.karyo.example.com

# --- Public Keycloak URL ---
KEYCLOAK_URL=https://cloud.karyo.example.com/auth
KC_HOSTNAME=https://cloud.karyo.example.com/auth

# Loopback-only host port for isolated Keycloak maintenance. An ordinary deployment
# publishes no Keycloak port; this one is bound only while
# infrastructure/docker/docker-compose.maintenance.yml is layered on (see DEPLOY.md).
KARYO_KEYCLOAK_MAINTENANCE_PORT=8181

# --- Resource Limits (tuned for 24GB Oracle Cloud Always Free) ---
APP_MEM_LIMIT=4g
JAVA_OPTS=-Xms256m -Xmx3g -XX:+UseContainerSupport -XX:MaxMetaspaceSize=256m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
GRADLE_OPTS=-Xmx2g -XX:MaxMetaspaceSize=512m
