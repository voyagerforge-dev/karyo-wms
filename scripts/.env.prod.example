# ============================================================================
# Karyo WMS Production Environment
# ============================================================================
# Copy to .env.prod and fill in values:
#   cp scripts/.env.prod.example scripts/.env.prod
#
# The deploy script validates required variables before starting containers.
# Variables marked REQUIRED must be set to real values (not CHANGE_ME).
# Variables marked OPTIONAL have working defaults for standard setups.
# ============================================================================

# --- REQUIRED: Shared PostgreSQL role ---
# The PostgreSQL container provisions one role used by Karyo and Keycloak. Keep all three
# usernames equal and all three passwords equal.
DB_USERNAME=karyo
DB_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_USER=karyo
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
KC_DB_USERNAME=karyo
KC_DB_PASSWORD=CHANGE_ME_strong_password_here

# --- OPTIONAL: Database connection and name ---
DB_URL=jdbc:postgresql://postgresql:5432/karyo
POSTGRES_DB=karyo

# --- Keycloak bootstrap admin (externally supplied, never realm-seeded) ---
# Required for a fresh Keycloak database or a --reset-db deploy; Keycloak ignores these on an
# existing database. Generate a unique username and a strong password of at least 16 characters.
# After provisioning the first Karyo administrator, delete that temporary account in Keycloak and
# delete both lines below.
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_bootstrap_admin_username
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_generate_a_strong_admin_password

# --- REQUIRED: Karyo user-administration service identity ---
# Distinct from the bootstrap account and OIDC secret. The production realm grants this client
# only manage-users and view-realm in the karyo realm.
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_generate_a_distinct_admin_client_secret

# --- OPTIONAL: OIDC (app -> Keycloak, internal network) ---
OIDC_URL=http://keycloak:8080/auth/realms/karyo
KEYCLOAK_ADMIN_URL=http://keycloak:8080/auth

# --- REQUIRED: OIDC client secret (karyo-backend service account) ---
# REQUIRED — must differ from the placeholder; matches the karyo-backend client secret in the
# Keycloak realm (see SC19 release note). Deploy fails if left as dev-backend-secret.
OIDC_SECRET=CHANGE_ME_generate_a_long_random_secret

# --- OPTIONAL: Module-internal client URLs (single app — all loopback) ---

# --- REQUIRED: Browser-canonical public origin (no default port, path, trailing slash, or wildcard) ---
# Binds karyo-web redirect URIs and web origins during the one-time production realm import.
KARYO_PUBLIC_ORIGIN=https://karyo.example.com

# --- REQUIRED: Public hostname ---
# Must equal the hostname portion of KARYO_PUBLIC_ORIGIN.
KARYO_DOMAIN=karyo.example.com

# --- OPTIONAL: Keycloak URL (defaults work for same-origin nginx deployments) ---
# KEYCLOAK_URL=/auth  # Relative is preferred; any absolute URL must use KARYO_PUBLIC_ORIGIN exactly.
KEYCLOAK_URL=/auth

# Loopback-only host port for isolated Keycloak maintenance. An ordinary deployment
# publishes no Keycloak port; this one is bound only while
# infrastructure/docker/docker-compose.maintenance.yml is layered on (see DEPLOY.md).
KARYO_KEYCLOAK_MAINTENANCE_PORT=8181

# --- REQUIRED: Keycloak Hostname (Keycloak 26 production mode) ---
# Must include the /auth context path so Keycloak generates correct frontend URLs.
# Set to http://<your-server-ip>/auth for local or https://<your-domain>/auth for cloud.
KC_HOSTNAME=https://karyo.example.com/auth

# --- Resource Limits ---
# Default deployment: leave commented (karyo-app defaults to 1536m via compose)
# Larger host: uncomment and adjust (see .env.prod.cloud-example)
# APP_MEM_LIMIT=1536m       # karyo-app container memory (compose default: 1536m)
# JAVA_OPTS=-Xms128m -Xmx1024m -XX:+UseContainerSupport -XX:MaxMetaspaceSize=192m -XX:+UseG1GC -Djava.security.egd=file:/dev/./urandom
# GRADLE_OPTS=-Xmx1g -XX:MaxMetaspaceSize=512m

# --- Deploy Script Flags ---
# ./scripts/deploy-server.sh            Full rebuild + deploy (default)
# ./scripts/deploy-server.sh --quick    Skip build, just restart containers
# ./scripts/deploy-server.sh --reset-db Destroy DB volumes, start fresh
# ./scripts/deploy-server.sh --validate-env scripts/.env.prod
# ./scripts/deploy-server.sh --help     Show all options

# --- v1.7 paid AI engines (open-core) — comma-separated module entitlements ---
# Empty/unset => all paid engines locked (Insights → Monitors / Forecasting show upsell).
# The public source build contains no commercial engine implementations.
# Entitlements cannot add absent code; keep this value empty.
KARYO_LICENSE=
# Signed license tokens apply only to customer images that contain commercial engines.
# Keep this value unset in a public source build.
# KARYO_LICENSE_KEY=

# --- v1.6 AI copilot (optional) — anthropic | ollama | none (default none = hidden) ---
# KARYO_AI_PROVIDER=none
# ANTHROPIC_API_KEY=

# --- karyo-demo (demo-only data engine) — on | off (default off) ---
# Generates/wipes a backdated demo warehouse via POST /api/v1/demo/{seed,reset} (ADMIN-only).
# MUST stay unset/off in real customer deployments -- only set to `on` on a demo/showcase box.
# KARYO_DEMO=on

# --- Receiving over-receipt hard stop — true | false (default true = today's per-request behavior) ---
# false makes this instance the STRICTER gate: a per-request allowOverReceipt=true on
# POST /api/v1/goods-receipts/{id}/lines can no longer override it.
# KARYO_RECEIVING_ALLOW_OVER_RECEIPT=false

# --- DELETABLE stock-unit reaper (row 18) -- true | false (default false) ---
# Irreversible: hard-deletes DELETABLE stock units past their retention window, then the unit
# loads they leave empty. Off by default on purpose; only enable once you mean it.
# KARYO_INVENTORY_PURGE=true
# KARYO_INVENTORY_PURGE_INTERVAL=1h
