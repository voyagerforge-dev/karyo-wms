<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- False positive: detekt-report-checkstyle is not Checkstyle -->
    <suppress>
        <notes>detekt-report-checkstyle matched against checkstyle CPE - not the same project</notes>
        <gav regex="true">dev\.detekt:detekt-report-checkstyle:.*</gav>
        <cve>CVE-2019-10782</cve>
        <cve>CVE-2019-9658</cve>
    </suppress>

    <!-- Transitive kotlin-reflect 1.6.10 pulled by build tooling, not runtime -->
    <suppress>
        <notes>kotlin-reflect 1.6.10 is a transitive build-time dependency, not used at runtime</notes>
        <gav regex="true">org\.jetbrains\.kotlin:kotlin-reflect:1\.6\.10</gav>
        <cve>CVE-2020-29582</cve>
    </suppress>

    <!-- Quarkus 3.25.3 known CVE - suppress until Quarkus releases patch -->
    <suppress>
        <notes>CVE-2025-66560 affects Quarkus 3.25.3 - will be resolved by upgrading Quarkus when patch is available</notes>
        <gav regex="true">io\.quarkus.*:.*:3\.25\.3</gav>
        <cve>CVE-2025-66560</cve>
    </suppress>

</suppressions>
